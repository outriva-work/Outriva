# Public site address, used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.outriva.com

# Project enquiries (optional). Sent by email through Resend (resend.com) when both are set.
# Without them, enquiries are printed to the server log in development and refused in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Outriva website <hello@outriva.com>
